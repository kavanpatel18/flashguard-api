# ─────────────────────────────────────────────────────────────────────────────
# FlashGuard v4 — Environment Configuration Template
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# Flask server settings
FLASK_ENV=production
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# Upstox API
# Paste your Bearer token from https://upstox.com/developer/api/v2
UPSTOX_TOKEN=

# Model settings
# Default risk threshold (0.0 – 1.0). Predictions above this are HIGH RISK.
MODEL_THRESHOLD=0.20
# Preferred model filename (must exist next to api_server.py)
DEFAULT_MODEL=improved_minute_model.keras

# Logging
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Optional: write logs to a file instead of stdout. Leave blank for stdout.
LOG_FILE=
